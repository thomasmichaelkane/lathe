# The dashboard and API — quarantine review, fetched approval, rip history.
#
# The only long-running service this repo ships. Everything else is a batch job
# triggered by udev, a path unit or a timer (§14).
#
# Runs on the host rather than in a container, unlike Navidrome. §5 explains
# why: /quarantine/{id}/resolve re-runs a beets import, and beets is installed
# per-user with uv on this machine. A container would have had to ship its own
# beets — two installs to keep in step, one of which writes to the library.

[Unit]
Description=librariand — library dashboard and API
After=network-online.target srv.mount
Wants=network-online.target

# Nothing works without the library drive. Without this the service starts on a
# boot where /srv failed to mount (which `nofail` makes an ordinary outcome),
# finds empty directories, and reports a healthy system with no music in it.
RequiresMountsFor=/srv

[Service]
Type=exec
User=music
Group=music

# LIBRARIAND_TOKEN lives here, alongside the ntfy topic and the Navidrome
# password. The leading '-' keeps the file optional: with no token set the
# dashboard runs open on the tailnet and says so on every page.
EnvironmentFile=-/etc/default/lathe

# No PATH line. beets used to be a per-user install in ~tom/.local/bin, which
# needed one here — and could not have worked anyway, since Debian home
# directories are private. install.sh now puts beet in /usr/local/bin, which is
# on systemd's default PATH for every service.

ExecStart=/usr/local/lib/librariand/venv/bin/python /usr/local/lib/librariand/app.py

Restart=on-failure
RestartSec=5

# A dashboard must never be the reason playback stutters or an import crawls.
Nice=5

# It reads and writes /srv and nothing else. These are cheap and rule out a
# whole class of mistake if a dependency is ever compromised.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Nothing it runs lives in a home directory any more, so it gets none of them.
ProtectHome=true
ReadWritePaths=/srv

[Install]
WantedBy=multi-user.target
