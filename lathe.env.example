# Environment for autorip@.service, inbox-import.service and librariand.service.
#
# install.sh copies this to /etc/default/lathe ONCE, if that file does not
# exist, and never touches it again — it will hold live credentials, which is
# why the copy is 0600 and root-owned and why the real one is not in the repo.
#
# Because it is never overwritten, a release that adds a setting here does not
# reach an existing install on its own. install.sh compares the two on every
# deploy and names any setting this template has that yours lacks, so you can
# add it by hand. It never edits your file.
#
# Everything here is optional: unset means the corresponding step is skipped
# and logged, never that an import or a rip fails.

# An ntfy topic URL is a capability — anyone holding it can push to your phone,
# so make it long and random. autorip.sh pushes rip FAILURES here;
# inbox-import.sh pushes the import summary (§6.4).
#
#   NTFY_URL=https://ntfy.sh/some-long-random-string
NTFY_URL=

# Poking Navidrome after an import drops the delay before a new album appears
# from up to ND_SCANSCHEDULE (6h) to seconds. Without it nothing breaks; the
# scheduled scan and the filesystem watcher still find everything.
#
# A Navidrome login. Subsonic token auth means the password is not sent over
# the wire, but it is stored here in plain text — which is what the 0600 and
# root ownership on this file are for.
#
#   NAVIDROME_URL=http://localhost:4533
#   NAVIDROME_USER=tom
#   NAVIDROME_PASS=
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASS=

# librariand's dashboard and API. Unset means no auth at all: anyone who can
# reach this machine on the tailnet can approve, merge and delete. That is a
# defensible choice with no ports exposed, which is why it is allowed — but it
# is a choice, and the dashboard says so until you make it.
#
# Generate one with:  openssl rand -hex 24
#
#   LIBRARIAND_TOKEN=...
LIBRARIAND_TOKEN=
